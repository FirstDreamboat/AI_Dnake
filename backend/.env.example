# ===== 应用配置 =====
APP_NAME=AI测试用例生成平台
APP_ENV=development
DEBUG=true
SECRET_KEY=please-change-me-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===== 数据库 (开发默认SQLite, 生产用MySQL) =====
DATABASE_URL=sqlite:///./data/db/app.db
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/ai_testcase?charset=utf8mb4

# ===== 向量库 =====
VECTOR_DB_TYPE=chroma
VECTOR_DB_PATH=./data/vector

# ===== 大模型 =====
# LLM_PROVIDER: ollama(本地) | deepseek(云端API)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_TEMPERATURE=0.3
# ===== 向量生成（云端优先，Ollama 兜底）=====
# EMBED_PROVIDER: siliconflow(云端硅基流动, 默认) | ollama(仅本地)
EMBED_PROVIDER=siliconflow
EMBED_API_KEY=
EMBED_API_BASE_URL=https://api.siliconflow.cn/v1
EMBED_CLOUD_MODEL=BAAI/bge-m3
EMBEDDING_MODEL=bge-m3
# ===== 视觉模型（原型图/设计稿解析，云端优先、Ollama 兜底）=====
# VISION_PROVIDER: siliconflow(云端硅基流动, 默认) | ollama(仅本地)
VISION_ENABLED=true
VISION_PROVIDER=siliconflow
VISION_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx   # 硅基流动 API Key（可复用 EMBED_API_KEY，https://cloud.siliconflow.cn）
VISION_API_BASE_URL=https://api.siliconflow.cn/v1
VISION_CLOUD_MODEL=Qwen/Qwen3-VL-32B-Instruct   # 云端视觉模型（OpenAI 兼容）
VISION_MODEL=qwen2.5vl:3b                          # Ollama 本地兜底模型（需预先 pull）
# DeepSeek API（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_TIMEOUT=600

# ===== RAG 检索 =====
RAG_TOP_K=5
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# ===== 上传与导出目录 =====
UPLOAD_DIR=./data/uploads
EXPORT_DIR=./data/exports

# ===== 前端CORS白名单 =====
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
